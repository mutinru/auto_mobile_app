<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: ничего не переносим ни в облачный бэкап, ни при переносе
     телефон-к-телефону. Почему — в комментарии у <application> в
     AndroidManifest.xml (ревью №37). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
